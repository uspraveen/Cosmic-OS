# Orchestrator environment
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8743
GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_TOKEN=<internal-service-token>
GATEWAY_SIGNING_SECRET=<gateway-signing-secret>
ANTHROPIC_API_KEY=<anthropic-api-key>
ANTHROPIC_MODEL=claude-opus-4-6
ANTHROPIC_OVERLOAD_RETRY_ATTEMPTS=1
ANTHROPIC_OVERLOAD_INITIAL_BACKOFF_SEC=1.0
ANTHROPIC_OVERLOAD_MAX_BACKOFF_SEC=4.0
ANTHROPIC_OVERLOAD_FALLBACK_MODEL=
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_PROMPT_CACHE_ENABLED=false
ANTHROPIC_MAX_INPUT_IMAGES=10
OPUS_MAX_TOKENS=16000

# Cosmic brain provider.
# anthropic keeps the current Claude/Anthropic SDK path.
# fireworks_kimi enables the Fireworks OpenAI-compatible Kimi K2.6 path.
COSMIC_ORCHESTRATOR_DEFAULT_PROVIDER=anthropic

# Fireworks Kimi path. Required only when COSMIC_ORCHESTRATOR_DEFAULT_PROVIDER
# is fireworks_kimi, or when the user selects Smarter in Settings.
ORCHESTRATOR_FIREWORKS_API_KEY=
ORCHESTRATOR_FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
ORCHESTRATOR_FIREWORKS_KIMI_MODEL=accounts/fireworks/models/kimi-k2p6
ORCHESTRATOR_FIREWORKS_MAX_TOKENS=16000
ORCHESTRATOR_FIREWORKS_TEMPERATURE=0.6

ORCHESTRATOR_REQUEST_TIMEOUT_SEC=300
REDIS_URL=redis://127.0.0.1:6379/0
AGENT_REGISTRY_DB_PATH=./registry/registry.db
AGENT_EVENTS_STREAM=streams:events
AGENT_EVENTS_GROUP=orchestrator
ORCHESTRATOR_AGENT_ID=cosmic/orchestrator:1.0.0
AGENT_SIGNING_SECRETS_JSON={}
ORCHESTRATOR_FEATURED_SPECIALISTS_ENABLED=true
ORCHESTRATOR_FEATURED_SPECIALISTS_COUNT=5
ORCHESTRATOR_FEATURED_SPECIALISTS_LOOKBACK_DAYS=15
ORCHESTRATOR_FEATURED_SPECIALISTS_REFRESH_SEC=300
TASK_INPUT_REQUESTS_STREAM=user_input:requests
TASK_INPUT_REPLIES_STREAM=user_input:replies
TASK_INPUT_ORCHESTRATOR_GROUP=orchestrator
ORCHESTRATOR_TASK_LEDGER_DB_PATH=./agents/orchestrator/store/data/task_ledger.db

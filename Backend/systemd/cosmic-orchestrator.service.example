[Unit]
Description=COSMIC Orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<SERVICE_USER>
Group=<SERVICE_GROUP>
WorkingDirectory=<BACKEND_ROOT>
EnvironmentFile=/etc/cosmic/orchestrator.env
EnvironmentFile=-/etc/cosmic/visual_enhancement.env
ExecStart=<BACKEND_ROOT>/.venv/bin/python -m orchestrator.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

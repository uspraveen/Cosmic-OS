[Unit]
Description=COSMIC Memory Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<SERVICE_USER>
Group=<SERVICE_GROUP>
WorkingDirectory=<BACKEND_ROOT>
EnvironmentFile=/etc/cosmic/memory.env
ExecStart=<BACKEND_ROOT>/.venv/bin/python -m uvicorn cosmic_memory.server.app:create_default_app --factory --host 127.0.0.1 --port 8090
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

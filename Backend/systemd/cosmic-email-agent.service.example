[Unit]
Description=COSMIC Email Agent
After=network-online.target redis.service
Wants=network-online.target

[Service]
Type=simple
User=<SERVICE_USER>
Group=<SERVICE_GROUP>
WorkingDirectory=<BACKEND_ROOT>
EnvironmentFile=/etc/cosmic/agents/email-agent.env
ExecStart=<BACKEND_ROOT>/.venv/bin/python -m agents.email_agent
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

[Unit]
Description=COSMIC X Twitter Search Agent
After=network-online.target redis.service
Wants=network-online.target

[Service]
Type=simple
User=<SERVICE_USER>
Group=<SERVICE_GROUP>
WorkingDirectory=<BACKEND_ROOT>
EnvironmentFile=/etc/cosmic/agents/x-twitter-search-agent.env
ExecStart=<BACKEND_ROOT>/.venv/bin/python -m agents.x_twitter_search
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

[Unit]
Description=COSMIC Alpha Agent
After=network-online.target cosmic-gateway.service cosmic-orchestrator.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=<SERVICE_USER>
Group=<SERVICE_GROUP>
WorkingDirectory=<BACKEND_ROOT>
EnvironmentFile=/etc/cosmic/agents/alpha-agent.env
ExecStart=<BACKEND_ROOT>/.venv/bin/python -m agents.alpha_agent
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

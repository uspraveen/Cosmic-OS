[Unit]
Description=COSMIC Google Docs Agent
After=network-online.target cosmic-gateway.service cosmic-orchestrator.service
Wants=network-online.target

[Service]
Type=simple
User=<SERVICE_USER>
Group=<SERVICE_GROUP>
WorkingDirectory=<BACKEND_ROOT>
EnvironmentFile=-/etc/cosmic/agents/gmail-agent.env
EnvironmentFile=-/etc/cosmic/agents/calendar-agent.env
EnvironmentFile=/etc/cosmic/agents/google-docs-agent.env
ExecStart=<BACKEND_ROOT>/.venv/bin/python -m agents.google_docs_agent
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

PERPLEXITY_API_KEY=<perplexity-api-key>
XAI_API_KEY=
GATEWAY_INTERNAL_TOKEN=<internal-service-token>
COSMIC_MEMORY_INTERNAL_TOKEN=<internal-service-token>
COSMIC_MEMORY_DATA_DIR=/var/lib/cosmic/memory
COSMIC_MEMORY_SYNC_ON_STARTUP=true
COSMIC_MEMORY_GRAPH_SYNC_ON_STARTUP=false
COSMIC_MEMORY_GRAPH_WARM_CACHE_ON_STARTUP=true
COSMIC_MEMORY_GRAPH_DETERMINISTIC_ENABLED=true
COSMIC_MEMORY_GRAPH_EXTRACT_ENABLED=false
COSMIC_MEMORY_GRAPH_BACKEND=neo4j
COSMIC_MEMORY_NEO4J_URI=bolt://127.0.0.1:7687
COSMIC_MEMORY_NEO4J_USERNAME=neo4j
COSMIC_MEMORY_NEO4J_PASSWORD=<neo4j-password>
COSMIC_MEMORY_NEO4J_DATABASE=neo4j
COSMIC_MEMORY_PRIMARY_USER_DISPLAY_NAME=<primary-user-display-name>
COSMIC_MEMORY_TIMEZONE=America/Chicago

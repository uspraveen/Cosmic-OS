# Gateway environment
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
# Public DNS hostname used by vm_edge_setup.py / Caddy TLS edge setup
GATEWAY_PUBLIC_HOST=<gateway.user.example.com>
# Optional explicit public base URL for short-lived signed artifact URLs. If blank,
# the Gateway derives https://<GATEWAY_PUBLIC_HOST>.
GATEWAY_PUBLIC_BASE_URL=
# Supabase owner user id for this single-user VM. Bootstrap can populate this from vm.user_id.
COSMIC_USER_ID=
GATEWAY_LOCAL_API_TOKEN=<desktop-local-api-token>
GATEWAY_INTERNAL_TOKEN=<internal-service-token>
GATEWAY_SIGNING_SECRET=<gateway-signing-secret>

# Mobile push notifications. Enabled by default; users can opt out in the mobile app.
ENABLE_PUSH_NOTIFICATIONS=true
EXPO_ACCESS_TOKEN=
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_TIMEOUT_SEC=8
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=
FCM_TIMEOUT_SEC=8
MOBILE_PRESENCE_STALE_SEC=120
MODEL_ROUTER_URL=http://127.0.0.1:8742
MODEL_ROUTER_TIMEOUT_SEC=15
ORCHESTRATOR_URL=http://127.0.0.1:8743
ORCHESTRATOR_TIMEOUT_SEC=300
ALPHA_CODEX_HOME=/var/lib/cosmic/alpha/homes/codex
ALPHA_CURSOR_HOME=/var/lib/cosmic/alpha/homes/cursor
REDIS_URL=redis://127.0.0.1:6379/0
TASK_INPUT_REQUESTS_STREAM=user_input:requests
TASK_INPUT_REPLIES_STREAM=user_input:replies
TASK_INPUT_GATEWAY_GROUP=gateway
# Same Anthropic key used by the Gateway's direct Haiku path.
ANTHROPIC_API_KEY=<anthropic-api-key>
ANTHROPIC_VERSION=2023-06-01
HAIKU_MODEL=claude-haiku-4-5
HAIKU_MAX_TOKENS=16000
HAIKU_THINKING_BUDGET_TOKENS=10000
PERPLEXITY_API_KEY=<perplexity-api-key>
PERPLEXITY_MODEL=sonar
CAPABILITY_WISHLIST_EMBEDDING_MODEL=pplx-embed-v1-4b
CAPABILITY_WISHLIST_EMBEDDING_DIMENSIONS=1024
XAI_API_KEY=
CAPABILITY_WISHLIST_ADJUDICATOR_MODEL=grok-4-1-fast-reasoning
DIRECT_LLM_TIMEOUT_SEC=90
# Leave blank to keep Gateway memory integration disabled until cosmic-memory is provisioned.
COSMIC_MEMORY_URL=
COSMIC_MEMORY_TIMEOUT_SEC=12
COSMIC_MEMORY_WRITE_TIMEOUT_SEC=45
COSMIC_MEMORY_CORE_FACT_MAX_CHARS=1500
COSMIC_MEMORY_PASSIVE_MAX_RESULTS=8
COSMIC_MEMORY_PASSIVE_TOKEN_BUDGET=12000
COSMIC_MEMORY_PASSIVE_KINDS=session_summary,task_summary,agent_note,user_data
COSMIC_MEMORY_INGEST_TRANSCRIPTS=true
COSMIC_MEMORY_EPISODE_EXTRACT_GRAPH=false
WHATSAPP_ENABLED=true
AGENT_EMAIL_ENABLED=false
GATEWAY_EMAIL_AGENT_ID=cosmic/email-agent:1.0.0
GATEWAY_GMAIL_AGENT_ID=cosmic/gmail-agent:1.0.0
GATEWAY_GMAIL_CONTEXT_DB_PATH=./gateway/gmail_context.db
GATEWAY_EVENT_AUTOMATION_DB_PATH=./gateway/event_automations.db
GATEWAY_GMAIL_WEBHOOK_SECRET=
GATEWAY_GMAIL_PROCESS_INBOUND_TIMEOUT_SEC=180
GATEWAY_GMAIL_PROCESS_INBOUND_POLL_INTERVAL_SEC=0.25
GATEWAY_GMAIL_WATCH_RENEWAL_INTERVAL_SEC=21600
GATEWAY_CALENDAR_AGENT_ID=cosmic/calendar-agent:1.0.0
GATEWAY_EMAIL_PROCESS_INBOUND_TIMEOUT_SEC=180
GATEWAY_EMAIL_PROCESS_INBOUND_POLL_INTERVAL_SEC=0.25
COSMIC_MAIL_BASE_URL=
COSMIC_MAIL_API_TOKEN=
COSMIC_MAIL_TIMEOUT_SEC=20
COSMIC_MAIL_PRIMARY_MAILBOX_ADDRESS=
COSMIC_MAIL_WEBHOOK_SECRET=
COSMIC_MAIL_WEBHOOK_SIGNATURE_HEADER=X-Cosmic-Mail-Signature
GATEWAY_ROUTING_AUDIT_DB_PATH=./gateway/routing_audit.db
GATEWAY_PREFERENCES_DB_PATH=./gateway/preferences.db
GATEWAY_ARTIFACTS_DB_PATH=./gateway/artifacts.db
GATEWAY_ARTIFACTS_ROOT=./runs/artifacts
GATEWAY_DELIVERY_QUEUE_DB_PATH=./gateway/delivery_queue.db
GATEWAY_SCHEDULER_DB_PATH=./gateway/scheduler.db
GATEWAY_USAGE_DB_PATH=./gateway/usage.db
GATEWAY_MEMORY_WRITE_AUDIT_DB_PATH=./gateway/memory_write_audit.db
GATEWAY_CAPABILITY_WISHLIST_DB_PATH=./gateway/cosmics_capability_wishlist.db
GATEWAY_CAPABILITY_WISHLIST_EXPORT_DIR=./logs/cosmics_capability_wishlist
GATEWAY_MEMORY_WRITE_MAX_PER_HOUR=50
GATEWAY_MEMORY_WRITE_DEDUP_TTL_SEC=86400
SESSION_RESET_HOUR=4
USER_TIMEZONE_FALLBACK=America/Chicago
GATEWAY_SCHEDULER_POLL_INTERVAL_SEC=30
GATEWAY_HEARTBEAT_INTERVAL_SEC=1800
COSMIC_HEARTBEAT_NOTES_PATH=./agents/orchestrator/store/heartbeat_notes.md
GATEWAY_HEARTBEAT_CALENDAR_DIGEST_ENABLED=true
GATEWAY_HEARTBEAT_CALENDAR_WINDOW_HOURS=24
GATEWAY_HEARTBEAT_CALENDAR_MAX_ACCOUNTS=4
GATEWAY_HEARTBEAT_CALENDAR_MAX_EVENTS=10
GATEWAY_HEARTBEAT_CALENDAR_AGENT_TIMEOUT_SEC=12
GATEWAY_HEARTBEAT_GMAIL_DIGEST_ENABLED=true
GATEWAY_HEARTBEAT_GMAIL_MAX_ACCOUNTS=4
GATEWAY_HEARTBEAT_GMAIL_MAX_ITEMS=6
GATEWAY_HEARTBEAT_GMAIL_AGENT_TIMEOUT_SEC=12
GATEWAY_DELIVERY_RETRY_BASE_SEC=1
GATEWAY_DELIVERY_RETRY_MAX_SEC=120
GATEWAY_DELIVERY_MAX_ATTEMPTS=12
GATEWAY_USAGE_QUEUE_MAX_SIZE=1000
GATEWAY_USAGE_QUEUE_FLUSH_TIMEOUT_SEC=5
GATEWAY_ARTIFACT_DOWNLOAD_TIMEOUT_SEC=60
GATEWAY_ARTIFACT_SIGNED_URL_TTL_SEC=300
GATEWAY_MAX_IMAGE_ATTACHMENTS_PER_MESSAGE=20
# Anthropic recommends keeping images within about 1.15 MP and <=1568 px on each side.
GATEWAY_LLM_IMAGE_MAX_EDGE_PX=1568
GATEWAY_LLM_IMAGE_MAX_PIXELS=1150000
GATEWAY_LLM_IMAGE_JPEG_QUALITY=85
GATEWAY_DOCS_AUTO_PARSE_ENABLED=true
GATEWAY_DOCS_PARSER_AGENT_ID=cosmic/docs-parser-agent:1.0.0
GATEWAY_DOCS_UPLOAD_MAX_FILE_BYTES=20971520
GATEWAY_DOCS_PARSE_TIMEOUT_SEC=300
GATEWAY_DOCS_PARSE_RECONCILE_TIMEOUT_SEC=900
GATEWAY_DOCS_PARSE_POLL_INTERVAL_SEC=0.25
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3000
WHATSAPP_BRIDGE_TOKEN=<whatsapp-bridge-token>
WHATSAPP_CHUNK_MODE=newline
WHATSAPP_TEXT_CHUNK_LIMIT=4000
WHATSAPP_SEND_DELAY_MS=200
WHATSAPP_ACK_DELAY_SEC=0
WHATSAPP_PROGRESS_MIN_INTERVAL_SEC=8
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
TELEGRAM_WEBHOOK_SECRET=<telegram-webhook-secret>
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_AUTO_CONFIGURE_WEBHOOK=true
TELEGRAM_TEXT_CHUNK_LIMIT=4000
TELEGRAM_SEND_DELAY_MS=120
TELEGRAM_CHAT_ACTION_MIN_INTERVAL_SEC=4

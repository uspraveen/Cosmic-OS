# Gateway environment
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
# Public DNS hostname used by vm_edge_setup.py / Caddy TLS edge setup
GATEWAY_PUBLIC_HOST=<gateway.user.example.com>
GATEWAY_LOCAL_API_TOKEN=<desktop-local-api-token>
GATEWAY_INTERNAL_TOKEN=<internal-service-token>
GATEWAY_SIGNING_SECRET=<gateway-signing-secret>
MODEL_ROUTER_URL=http://127.0.0.1:8742
MODEL_ROUTER_TIMEOUT_SEC=15
ORCHESTRATOR_URL=http://127.0.0.1:8743
ORCHESTRATOR_TIMEOUT_SEC=300
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-3-flash-preview
PERPLEXITY_API_KEY=<perplexity-api-key>
PERPLEXITY_MODEL=sonar
DIRECT_LLM_TIMEOUT_SEC=90
WHATSAPP_ENABLED=true
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3000
WHATSAPP_BRIDGE_TOKEN=<whatsapp-bridge-token>
WHATSAPP_CHUNK_MODE=newline
WHATSAPP_TEXT_CHUNK_LIMIT=4000
WHATSAPP_SEND_DELAY_MS=200
WHATSAPP_PROGRESS_MIN_INTERVAL_SEC=8

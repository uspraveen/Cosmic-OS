# Gateway environment
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_LOCAL_API_TOKEN=<desktop-local-api-token>
GATEWAY_INTERNAL_TOKEN=<internal-service-token>
MODEL_ROUTER_URL=http://127.0.0.1:8742
MODEL_ROUTER_TIMEOUT_SEC=15
WHATSAPP_ENABLED=true
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3000
WHATSAPP_BRIDGE_TOKEN=<whatsapp-bridge-token>
WHATSAPP_CHUNK_MODE=newline
WHATSAPP_TEXT_CHUNK_LIMIT=4000
WHATSAPP_SEND_DELAY_MS=200
WHATSAPP_PROGRESS_MIN_INTERVAL_SEC=8

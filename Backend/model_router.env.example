# Model Router environment
GROQ_API_KEY=<groq-api-key>
CLASSIFIER_MODEL=openai/gpt-oss-20b
MODEL_ROUTER_HOST=0.0.0.0
MODEL_ROUTER_PORT=8742
HTTP2_ENABLED=true
CONNECTION_POOL_SIZE=10
KEEPALIVE_EXPIRY=30
MODEL_ROUTER_HTTP_TIMEOUT_SEC=30
MODEL_ROUTER_CONNECT_TIMEOUT_SEC=10
MODEL_ROUTER_DEFAULT_MAX_COMPLETION_TOKENS=430
MODEL_ROUTER_LOW_CONFIDENCE_THRESHOLD=0.5
MODEL_ROUTER_LOG_LEVEL=INFO

# Visual response enhancement sidecar settings
# This file is optional. The orchestrator also falls back to shared Firecrawl / Fireworks env vars.

VISUAL_ENHANCEMENT_ENABLED=true
VISUAL_ENHANCEMENT_MAX_VISUALS_PER_TURN=5
VISUAL_ENHANCEMENT_MAX_IMAGE_SLOTS_PER_TURN=5
VISUAL_ENHANCEMENT_MAX_CHART_SLOTS_PER_TURN=1
VISUAL_ENHANCEMENT_MAX_CONCURRENT_SIDECARS=2
# Explicit image requests need enough time for search, verification, and download.
# Automatic image suggestions can still set a shorter per-slot timeout in runtime.
VISUAL_ENHANCEMENT_IMAGE_SLOT_TIMEOUT_MS=30000
VISUAL_ENHANCEMENT_CHART_SLOT_TIMEOUT_MS=4000
VISUAL_ENHANCEMENT_FINALIZATION_GRACE_MS=750
VISUAL_ENHANCEMENT_IMAGE_SOURCE_PAGE_LIMIT=3
VISUAL_ENHANCEMENT_IMAGE_CANDIDATE_LIMIT=24
VISUAL_ENHANCEMENT_IMAGE_MAX_BYTES=8388608
VISUAL_ENHANCEMENT_IMAGE_VERIFY_TOP_K=3
VISUAL_ENHANCEMENT_IMAGE_MIN_CONFIDENCE=0.58
VISUAL_ENHANCEMENT_IMAGE_SEARCH_ENABLED=true
VISUAL_ENHANCEMENT_IMAGE_SEARCH_BASE_URL=https://www.bing.com/images/search
VISUAL_ENHANCEMENT_IMAGE_SEARCH_TIMEOUT_SEC=12
VISUAL_ENHANCEMENT_IMAGE_SEARCH_RESULT_LIMIT=12
VISUAL_ENHANCEMENT_CHART_MAX_POINTS=200
VISUAL_ENHANCEMENT_CHART_MAX_BYTES=4194304
VISUAL_ENHANCEMENT_DOWNLOAD_TIMEOUT_SEC=20

# Dedicated verifier / scorer model (OpenAI-compatible Fireworks endpoint).
# Falls back to MODEL_API_KEY / FIREWORKS_API_KEY / OPENAI_COMPAT_API_KEY when unset.
VISUAL_ENHANCEMENT_FIREWORKS_API_KEY=
VISUAL_ENHANCEMENT_FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
VISUAL_ENHANCEMENT_FIREWORKS_MODEL=accounts/fireworks/models/kimi-k2p6
VISUAL_ENHANCEMENT_FIREWORKS_VISION_MODEL=accounts/fireworks/models/kimi-k2p6
VISUAL_ENHANCEMENT_FIREWORKS_REASONING_EFFORT=low
VISUAL_ENHANCEMENT_FIREWORKS_TIMEOUT_SEC=20

# Image retrieval reuses Firecrawl. These also fall back to FIRECRAWL_* when unset.
VISUAL_ENHANCEMENT_FIRECRAWL_API_KEY=
VISUAL_ENHANCEMENT_FIRECRAWL_BASE_URL=https://api.firecrawl.dev
VISUAL_ENHANCEMENT_FIRECRAWL_REQUEST_TIMEOUT_SEC=20

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "account"],
  "properties": {
    "status": { "type": "string" },
    "account": { "type": "object" },
    "thread": { "type": "object" },
    "reason": { "type": "string" },
    "items": { "type": "array", "items": { "type": "object" } },
    "messages": { "type": "array", "items": { "type": "object" } },
    "llm_used": { "type": "boolean" },
    "skipped_by_prefilter": { "type": "array", "items": { "type": "object" } },
    "added_prefilters": { "type": "array", "items": { "type": "object" } },
    "summary": { "type": "string" },
    "history_id": { "type": "string" },
    "message": { "type": "string" }
  }
}

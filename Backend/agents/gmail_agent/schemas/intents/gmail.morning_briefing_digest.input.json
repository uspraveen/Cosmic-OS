{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "description": "Bounded Gmail query for the briefing scan; defaults to recent non-trash mail."
    },
    "context_brief": { "type": "string" },
    "max_items": { "type": "integer", "minimum": 1, "maximum": 30, "default": 12 },
    "account_id": { "type": "string" },
    "account_hint": { "type": "string" }
  }
}

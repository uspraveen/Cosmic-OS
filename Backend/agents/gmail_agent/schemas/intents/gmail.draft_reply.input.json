{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "request": { "type": "string", "description": "Natural-language drafting request." },
    "query": { "type": "string" },
    "thread_id": { "type": "string" },
    "message_id": { "type": "string" },
    "draft_id": { "type": "string", "description": "Exact existing Gmail draft to update instead of creating another draft." },
    "update_existing_draft": { "type": "boolean", "description": "When true and thread_id is present, safely update the sole existing draft in that thread; fail rather than guess when multiple drafts exist." },
    "to": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "cc": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "bcc": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
    "subject": { "type": "string" },
    "body": { "type": "string" },
    "context_brief": { "type": "string" },
    "account_id": { "type": "string" },
    "account_hint": { "type": "string" }
  }
}

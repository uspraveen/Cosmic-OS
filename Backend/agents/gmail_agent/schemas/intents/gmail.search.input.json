{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query": { "type": "string", "description": "Gmail search query or natural search phrase." },
    "from": { "type": "string", "description": "Optional sender email/name hint." },
    "subject": { "type": "string", "description": "Optional subject filter." },
    "unread": { "type": "boolean", "description": "When true, include is:unread." },
    "after": { "type": "string", "description": "Optional Gmail after: date filter." },
    "before": { "type": "string", "description": "Optional Gmail before: date filter." },
    "max_results": { "type": "integer", "minimum": 1, "maximum": 50, "default": 10 },
    "account_id": { "type": "string" },
    "account_hint": { "type": "string" }
  }
}

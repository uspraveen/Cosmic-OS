{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query": { "type": "string", "description": "Bounded Gmail query; defaults to recent non-trash messages." },
    "context_brief": { "type": "string" },
    "max_results": { "type": "integer", "minimum": 1, "maximum": 40, "default": 12 },
    "account_id": { "type": "string" },
    "account_hint": { "type": "string" }
  }
}

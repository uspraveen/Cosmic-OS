# Gmail Agent environment variables
# Copy to /etc/cosmic/agents/gmail-agent.env and fill in values.

REDIS_URL=redis://127.0.0.1:6379/0
GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_TOKEN=
AGENT_SECRET=
INSTANCE_ID=gmail-agent-local-1
GMAIL_AGENT_ENABLED=true

# Internal LLM for Gmail triage and drafting
GMAIL_AGENT_INTERNAL_LLM_API_KEY=
GMAIL_AGENT_INTERNAL_LLM_BASE_URL=https://api.openai.com/v1
GMAIL_AGENT_INTERNAL_LLM_MODEL=gpt-5.6-luna
GMAIL_AGENT_INTERNAL_LLM_REASONING_EFFORT=xhigh
GMAIL_AGENT_INTERNAL_LLM_TIMEOUT_SEC=90.0
GMAIL_AGENT_ENABLE_INTERNAL_LLM=true

# Gmail agent bounds
GMAIL_AGENT_MAX_SEARCH_RESULTS=10
GMAIL_AGENT_MAX_TRIAGE_MESSAGES=12
GMAIL_AGENT_MAX_THREAD_MESSAGES=40
GMAIL_AGENT_MAX_BODY_CHARS=6000
GMAIL_AGENT_MAX_DIGEST_ITEMS=6
GMAIL_AGENT_AUTO_PREFILTER_HIGH_CONFIDENCE_NOISE=true
GMAIL_AGENT_PREFILTER_CONFIDENCE_THRESHOLD=0.92

# Optional Gmail push watch support. Requires Google Cloud Pub/Sub topic setup.
GMAIL_WATCH_TOPIC_NAME=
GMAIL_WATCH_LABEL_IDS=INBOX
GMAIL_WEBHOOK_SECRET=

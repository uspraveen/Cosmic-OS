{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "browser.recall_session output",
  "description": "Prior browser.run entries for a session, newest first. Cheap lookup — no browser is launched.",
  "type": "object",
  "required": ["response", "session_id", "entries"],
  "properties": {
    "response": {"type": "string"},
    "session_id": {"type": "string"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "goal", "status", "summary", "created_at"],
        "properties": {
          "task_id": {"type": "string"},
          "goal": {"type": "string"},
          "status": {
            "type": "string",
            "enum": ["success", "incomplete", "failed", "credentials_needed"]
          },
          "summary": {
            "type": "string",
            "description": "One-line recall summary (or the run's final answer when no summary was produced)."
          },
          "target_url": {"type": ["string", "null"]},
          "artifact_refs": {
            "type": "array",
            "items": {"type": "object"},
            "description": "Pointers into the run's own artifacts (final screenshot, run_dir) — not duplicated here."
          },
          "created_at": {"type": "string"}
        }
      }
    }
  }
}

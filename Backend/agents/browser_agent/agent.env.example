# COSMIC Browser Agent — environment overrides (copy to agent.env)
# The checkout of cosmic-browser-use (contains main.py / browser_memory).
# Defaults to a sibling of the Cosmic-OS repo, same layout as cosmic-memory.
# BROWSER_USE_HOME=/home/ubuntu/cosmic/cosmic-browser-use/cosmic-browser-use

# Redis + Gateway (inherited from the shared backend env on the VM)
# REDIS_URL=redis://127.0.0.1:6379/0
# GATEWAY_URL=http://127.0.0.1:8080
# GATEWAY_INTERNAL_TOKEN=

# Browser run behaviour
# BROWSER_AGENT_HEADLESS=true
# BROWSER_AGENT_MAX_STEPS=40
# BROWSER_AGENT_RUN_TIMEOUT_SEC=840

# AskUser mid-run interrupts (OTP, CAPTCHA/bot checks, phone approval,
# ambiguous forms) — how long the desktop's answer card waits before the
# agent gives up and moves on. ASK_USER_TIMEOUT is cosmic-browser-use's own
# wrapper timeout around our handler and must be >= the value below or it
# cuts the wait short regardless of what we configure here.
# BROWSER_AGENT_ASK_USER_TIMEOUT_SEC=240
# ASK_USER_TIMEOUT=240

# Model set: "bu" (default) = browser-use's hosted bu-2-0 as the base brain,
# GLM 5.3 Flash (Fireworks) as escalation. "legacy" = GLM 5.3 Flash as the
# base brain, xAI grok-4.6 as escalation (the pre-BU default). If BU is
# selected but BROWSER_USE_API_KEY is missing, it falls back to legacy
# automatically — safe to leave unset until the key is provisioned.
# BROWSER_AGENT_MODEL_SET=bu

# Base brain: browser-use hosted cloud model (get a key at cloud.browser-use.com)
# BROWSER_USE_API_KEY=
# BROWSER_USE_MODEL=bu-2-0

# Escalation brain in "bu" mode / base brain in "legacy" mode (Fireworks)
# BROWSER_AGENT_MODEL=accounts/fireworks/models/glm-5p3-flash
# FIREWORKS_API_KEY=

# Frontier escalation brain in "legacy" mode only (xAI grok)
# XAI_API_KEY=

# MiMo vision grounding (Modal endpoint)
# MIMO_API_URL=
# MIMO_API_KEY=

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query": { "type": "string", "description": "Natural language query or title search" },
    "time_min": { "type": "string", "description": "ISO 8601 start of time range" },
    "time_max": { "type": "string", "description": "ISO 8601 end of time range" },
    "calendar_id": { "type": "string", "description": "Google calendar ID, defaults to 'primary'", "default": "primary" },
    "account_hint": { "type": "string", "description": "Friendly account selector like work, personal, or an email address" },
    "max_results": { "type": "integer", "description": "Max events to return", "default": 50 },
    "timezone": { "type": "string", "description": "IANA timezone for display" }
  }
}

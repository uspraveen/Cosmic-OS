# Calendar Agent environment variables
# Copy to /etc/cosmic/agents/calendar-agent.env and fill in values

REDIS_URL=redis://127.0.0.1:6379/0
GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_TOKEN=
AGENT_SECRET=
INSTANCE_ID=calendar-agent-local-1

# Internal LLM (gpt-5-mini) for natural language parsing
CALENDAR_AGENT_INTERNAL_LLM_API_KEY=
CALENDAR_AGENT_INTERNAL_LLM_BASE_URL=
CALENDAR_AGENT_INTERNAL_LLM_MODEL=gpt-5.6-luna
CALENDAR_AGENT_INTERNAL_LLM_REASONING_EFFORT=xhigh
CALENDAR_AGENT_INTERNAL_LLM_TIMEOUT_SEC=120.0
CALENDAR_AGENT_ENABLE_INTERNAL_LLM=true
CALENDAR_AGENT_USE_LANGGRAPH=true
CALENDAR_AGENT_MAX_TOOL_ROUNDS=6

# Calendar defaults
CALENDAR_AGENT_DEFAULT_TIMEZONE=America/Chicago
CALENDAR_AGENT_WORKING_HOUR_START=9
CALENDAR_AGENT_WORKING_HOUR_END=17
CALENDAR_AGENT_DEFAULT_EVENT_DURATION_MIN=30
CALENDAR_AGENT_BUFFER_MIN=15
CALENDAR_AGENT_MAX_EVENTS_PER_LIST=50

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query": { "type": "string", "description": "Natural-language map request" },
    "description": { "type": "string", "description": "Alias for query" },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "context": { "type": "string" },
    "draw_route": { "type": "boolean", "default": false },
    "route_alternatives": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6,
      "description": "Number of OSRM route alternatives to request for a single origin/destination route"
    },
    "alternatives": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6,
      "description": "Alias for route_alternatives"
    },
    "route_profile": { "type": "string", "enum": ["driving", "walking", "cycling"] },
    "route_waypoints": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string" },
          {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "name": { "type": "string" },
              "query": { "type": "string" },
              "address": { "type": "string" },
              "lat": { "type": "number" },
              "lng": { "type": "number" },
              "lon": { "type": "number" },
              "latitude": { "type": "number" },
              "longitude": { "type": "number" }
            }
          }
        ]
      },
      "description": "Ordered stops for routing. Items may be place strings or coordinate objects."
    },
    "stops": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string" },
          { "type": "object" }
        ]
      },
      "description": "Alias for route_waypoints"
    },
    "waypoints": {
      "type": "array",
      "items": {
        "anyOf": [
          { "type": "string" },
          { "type": "object" }
        ]
      },
      "description": "Alias for route_waypoints"
    },
    "route_options": {
      "type": "array",
      "description": "Multiple route choices to draw on the same map",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "name": { "type": "string" },
          "route_profile": { "type": "string", "enum": ["driving", "walking", "cycling"] },
          "profile": { "type": "string", "enum": ["driving", "walking", "cycling"] },
          "route_waypoints": {
            "type": "array",
            "items": {
              "anyOf": [
                { "type": "string" },
                { "type": "object" }
              ]
            },
            "description": "Ordered stops for this route choice. Items may be place strings or coordinate objects."
          },
          "stops": {
            "type": "array",
            "items": {
              "anyOf": [
                { "type": "string" },
                { "type": "object" }
              ]
            },
            "description": "Alias for route_waypoints"
          },
          "waypoints": {
            "type": "array",
            "items": {
              "anyOf": [
                { "type": "string" },
                { "type": "object" }
              ]
            },
            "description": "Alias for route_waypoints"
          },
          "color": { "type": "string" },
          "description": { "type": "string" },
          "alternatives": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          }
        },
        "anyOf": [
          { "required": ["route_waypoints"] },
          { "required": ["stops"] },
          { "required": ["waypoints"] }
        ]
      }
    },
    "shapes": {
      "type": "array",
      "description": "Visual overlays to draw on the map, such as boxes, polygons, circles, or highlighted boundaries.",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["rectangle", "box", "polygon", "circle", "boundary", "outline"] },
          "label": { "type": "string" },
          "name": { "type": "string" },
          "target": { "type": "string", "description": "Geocodable place to draw the shape around when exact coordinates are not known." },
          "around": { "type": "string", "description": "Alias for target." },
          "query": { "type": "string", "description": "Alias for target." },
          "color": { "type": "string" },
          "fillColor": { "type": "string" },
          "fill_color": { "type": "string" },
          "fillOpacity": { "type": "number" },
          "fill_opacity": { "type": "number" },
          "weight": { "type": "integer" },
          "radius_m": { "type": "number" },
          "bounds": {
            "type": "object",
            "properties": {
              "southwest": { "anyOf": [{ "type": "object" }, { "type": "array" }, { "type": "string" }] },
              "northeast": { "anyOf": [{ "type": "object" }, { "type": "array" }, { "type": "string" }] },
              "sw": { "anyOf": [{ "type": "object" }, { "type": "array" }, { "type": "string" }] },
              "ne": { "anyOf": [{ "type": "object" }, { "type": "array" }, { "type": "string" }] }
            }
          },
          "northwest": { "anyOf": [{ "type": "object" }, { "type": "array" }, { "type": "string" }] },
          "southeast": { "anyOf": [{ "type": "object" }, { "type": "array" }, { "type": "string" }] },
          "nw": { "anyOf": [{ "type": "object" }, { "type": "array" }, { "type": "string" }] },
          "se": { "anyOf": [{ "type": "object" }, { "type": "array" }, { "type": "string" }] },
          "north": { "type": "number" },
          "south": { "type": "number" },
          "east": { "type": "number" },
          "west": { "type": "number" },
          "center": { "anyOf": [{ "type": "object" }, { "type": "array" }, { "type": "string" }] },
          "coordinates": {
            "type": "array",
            "items": {
              "anyOf": [
                { "type": "string" },
                { "type": "object" },
                {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 2
                }
              ]
            }
          },
          "points": {
            "type": "array",
            "items": {
              "anyOf": [
                { "type": "string" },
                { "type": "object" }
              ]
            }
          },
          "description": { "type": "string" }
        }
      }
    },
    "overlays": {
      "type": "array",
      "description": "Alias for shapes.",
      "items": { "type": "object" }
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "query": { "type": "string" },
          "address": { "type": "string" },
          "lat": { "type": "number" },
          "lng": { "type": "number" },
          "lon": { "type": "number" },
          "latitude": { "type": "number" },
          "longitude": { "type": "number" },
          "color": { "type": "string" },
          "kind": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}

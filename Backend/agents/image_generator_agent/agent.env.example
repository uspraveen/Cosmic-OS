# Copy to agent.env and set secrets locally. Do not commit agent.env.
REDIS_URL=redis://127.0.0.1:6379/0
GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_TOKEN=
AGENT_SECRET=
INSTANCE_ID=image-generator-agent-local-1

# Internal router LLM. The current official GPT-5 mini model id is gpt-5-mini.
IMAGE_AGENT_ENABLE_INTERNAL_ROUTER_LLM=true
IMAGE_AGENT_ROUTER_API_KEY=
IMAGE_AGENT_ROUTER_BASE_URL=https://api.openai.com/v1
IMAGE_AGENT_ROUTER_MODEL=gpt-5-mini
IMAGE_AGENT_ROUTER_TIMEOUT_SEC=45

# OpenAI image generation
IMAGE_AGENT_OPENAI_API_KEY=
IMAGE_AGENT_OPENAI_BASE_URL=https://api.openai.com/v1
IMAGE_AGENT_OPENAI_MODEL=gpt-image-1.5
IMAGE_AGENT_OPENAI_TIMEOUT_SEC=180

# xAI image generation
IMAGE_AGENT_XAI_API_KEY=
IMAGE_AGENT_XAI_BASE_URL=https://api.x.ai/v1
IMAGE_AGENT_XAI_MODEL=grok-imagine-image-pro
IMAGE_AGENT_XAI_TIMEOUT_SEC=180

IMAGE_AGENT_DEFAULT_PROVIDER=xai
IMAGE_AGENT_DEFAULT_SIZE=1024x1024
IMAGE_AGENT_DEFAULT_QUALITY=high
IMAGE_AGENT_MAX_IMAGES_PER_REQUEST=4
IMAGE_AGENT_MAX_REFERENCE_IMAGES=4
IMAGE_AGENT_MAX_PROMPT_CHARS=6000
IMAGE_AGENT_GENERATION_POLL_INTERVAL_SEC=0

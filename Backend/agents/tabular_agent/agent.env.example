# Copy to agent.env and set secrets locally. Do not commit agent.env.
REDIS_URL=redis://127.0.0.1:6379/0
GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_TOKEN=
AGENT_SECRET=
INSTANCE_ID=tabular-agent-local-1

# OpenAI-compatible internal LLM API.
TABULAR_AGENT_INTERNAL_LLM_API_KEY=
# Root only, ending in /v1 — do NOT add /chat/completions (the SDK appends it).
# Example:
#   TABULAR_AGENT_INTERNAL_LLM_BASE_URL=https://api.openai.com/v1
TABULAR_AGENT_INTERNAL_LLM_BASE_URL=
TABULAR_AGENT_INTERNAL_LLM_MODEL=gpt-5.6-terra
TABULAR_AGENT_INTERNAL_LLM_REASONING_EFFORT=xhigh
TABULAR_AGENT_INTERNAL_LLM_TIMEOUT_SEC=120
TABULAR_AGENT_ENABLE_INTERNAL_LLM=true
# Append FP&A supplement via prompt_assets.build_internal_context (summarize/plan only; internal LLM uses summarize).
TABULAR_AGENT_INCLUDE_FPAN_PROMPT=false
# Internal tabular.reason_workbook: LangGraph multi-step (default) vs legacy single-shot.
TABULAR_AGENT_REASON_USE_LANGGRAPH=true
# Max internal tool executions per reasoning task (browse/schema/preview/sql/python/clarify each count as one).
TABULAR_AGENT_REASON_MAX_TOOL_ROUNDS=5
# Mid-task clarify: HTTP POST to orchestrator /internal/tasks/{parent_task_id}/request-input (see INTEROP.md).
TABULAR_AGENT_ORCHESTRATOR_URL=http://127.0.0.1:8743
TABULAR_AGENT_ORCHESTRATOR_INTERNAL_TOKEN=
TABULAR_AGENT_REASON_CLARIFY_WAIT_SEC=600
# Sandbox execution policy (see INTEROP.md for full details).
TABULAR_AGENT_SANDBOX_TIMEOUT_SEC=45
# Allow generated code to make network calls (relaxes regex denylist for requests/httpx/urllib/socket).
TABULAR_AGENT_SANDBOX_ALLOW_NETWORK=false
# Allow per-execution pip install into isolated venv (packages logged in execution receipt).
TABULAR_AGENT_SANDBOX_ALLOW_PIP=false
TABULAR_AGENT_SANDBOX_PIP_TIMEOUT_SEC=120
# Root directory for cached venvs (by package-set hash). Empty = use temp dir.
TABULAR_AGENT_SANDBOX_VENV_CACHE_ROOT=

# Local smoke test (no Redis):
#   from Backend/:  python scripts/local_test_openai_compat_langchain.py
#   from repo root:  python scripts/local_test_openai_compat_langchain.py
# See agents/tabular_agent/INTEROP.md for Redis / registry / task envelope alignment.

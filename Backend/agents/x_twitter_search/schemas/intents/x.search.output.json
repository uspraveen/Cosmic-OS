{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "response": { "type": "string" },
    "message": { "type": "string" },
    "query": { "type": "string" },
    "summary": { "type": "string" },
    "key_findings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notable_posts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "author_handle": { "type": ["string", "null"] },
          "post_url": { "type": ["string", "null"] },
          "posted_at": { "type": ["string", "null"] },
          "excerpt": { "type": "string" },
          "why_it_matters": { "type": "string" }
        },
        "required": ["excerpt", "why_it_matters"]
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "description": { "type": "string" }
        },
        "required": ["url"]
      }
    },
    "filters": { "type": "object" },
    "tool_usage": { "type": "object" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": { "type": "string" },
          "path": { "type": "string" },
          "mime": { "type": "string" }
        },
        "required": ["artifact_id", "path", "mime"]
      }
    }
  },
  "required": ["response", "message", "query", "summary", "key_findings", "notable_posts", "citations", "filters"]
}


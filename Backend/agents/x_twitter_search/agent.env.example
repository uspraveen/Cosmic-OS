REDIS_URL=redis://127.0.0.1:6379/0
GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_TOKEN=<internal-service-token>
AGENT_SECRET=<agent-shared-secret>
INSTANCE_ID=x-twitter-search-agent-1
# Bootstrap fills the shared token/secret values. A real XAI_API_KEY is what
# makes the agent eligible for enable/start during provisioning.
XAI_API_KEY=<xai-api-key>
X_SEARCH_MODEL=grok-4.20-0309-reasoning
X_SEARCH_MAX_OUTPUT_TOKENS=2200
X_SEARCH_REQUEST_TIMEOUT_SEC=90
X_SEARCH_MAX_POSTS=8

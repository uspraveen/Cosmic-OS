{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "response": { "type": "string" },
    "message": { "type": "string" },
    "url": { "type": "string" },
    "title": { "type": ["string", "null"] },
    "available_formats": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metadata": {
      "type": "object"
    },
    "data": {
      "type": "object"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": { "type": "string" },
          "path": { "type": "string" },
          "mime": { "type": "string" }
        },
        "required": ["artifact_id", "path", "mime"]
      }
    }
  },
  "required": ["response", "message", "url", "available_formats", "data"]
}

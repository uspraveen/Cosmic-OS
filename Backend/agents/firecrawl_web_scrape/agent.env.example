REDIS_URL=redis://127.0.0.1:6379/0
GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_TOKEN=<internal-service-token>
AGENT_SECRET=<agent-shared-secret>
INSTANCE_ID=firecrawl-web-scrape-agent-1
# Bootstrap fills the shared token/secret values. A real FIRECRAWL_API_KEY is
# what makes the agent eligible for enable/start during provisioning.
FIRECRAWL_API_KEY=<firecrawl-api-key>
FIRECRAWL_API_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_REQUEST_TIMEOUT_SEC=120
FIRECRAWL_EXTRACT_POLL_INTERVAL_SEC=2
FIRECRAWL_EXTRACT_MAX_WAIT_SEC=120

REDIS_URL=redis://127.0.0.1:6379/0
GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_TOKEN=<internal-service-token>
AGENT_SECRET=<agent-shared-secret>
INSTANCE_ID=firecrawl-web-scrape-agent-1
# Bootstrap fills the shared token/secret values. A real FIRECRAWL_API_KEY is
# what makes the agent eligible for enable/start during provisioning.
FIRECRAWL_API_KEY=<firecrawl-api-key>
FIRECRAWL_API_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_REQUEST_TIMEOUT_SEC=120
FIRECRAWL_EXTRACT_POLL_INTERVAL_SEC=2
FIRECRAWL_EXTRACT_MAX_WAIT_SEC=120
# Inline excerpt budgets surfaced back to the orchestrator (full bodies always live in artifacts).
FIRECRAWL_INLINE_MARKDOWN_CHARS=12000
FIRECRAWL_INLINE_HTML_CHARS=6000
# Capture page screenshots as image/png artifacts so the vision model can read image-locked tables/charts.
FIRECRAWL_SCREENSHOT_AS_IMAGE_ARTIFACT=true
FIRECRAWL_SCREENSHOT_DOWNLOAD_TIMEOUT_SEC=30
FIRECRAWL_SCREENSHOT_MAX_BYTES=12000000
# Capture full-page screenshots by default (content below the fold), with quality/viewport.
FIRECRAWL_SCREENSHOT_FULL_PAGE=true
FIRECRAWL_SCREENSHOT_QUALITY=80
FIRECRAWL_SCREENSHOT_VIEWPORT_WIDTH=1280

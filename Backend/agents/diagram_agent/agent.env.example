# Diagram Agent environment variables
# Copy to /etc/cosmic/agents/diagram-agent.env and fill in values

REDIS_URL=redis://127.0.0.1:6379/0
GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_TOKEN=
AGENT_SECRET=
INSTANCE_ID=diagram-agent-local-1

# Internal LLM (gpt-5-mini)
DIAGRAM_AGENT_MIMO_API_KEY=
DIAGRAM_AGENT_MIMO_BASE_URL=
DIAGRAM_AGENT_MIMO_MODEL=gpt-5-mini
DIAGRAM_AGENT_MIMO_TIMEOUT_SEC=120.0
DIAGRAM_AGENT_ENABLE_INTERNAL_LLM=true

# LangGraph
DIAGRAM_AGENT_USE_LANGGRAPH=true
DIAGRAM_AGENT_MAX_TOOL_ROUNDS=6

# Renderer paths (CLI binaries)
DIAGRAM_AGENT_MMDC_PATH=mmdc
DIAGRAM_AGENT_D2_PATH=d2
PUPPETEER_CACHE_DIR=/var/lib/cosmic/diagram-agent/puppeteer

# Rendering defaults
DIAGRAM_AGENT_DEFAULT_FORMAT=svg
DIAGRAM_AGENT_DEFAULT_THEME=default
DIAGRAM_AGENT_MERMAID_BG=white
DIAGRAM_AGENT_MERMAID_DISABLE_SANDBOX=true
DIAGRAM_AGENT_D2_SKETCH=false
DIAGRAM_AGENT_D2_PAD=100
DIAGRAM_AGENT_MAX_WIDTH_PX=2400
DIAGRAM_AGENT_MAX_HEIGHT_PX=1600

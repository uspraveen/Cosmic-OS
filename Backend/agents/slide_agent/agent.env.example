# Copy to agent.env and set secrets locally. Do not commit agent.env.
REDIS_URL=redis://127.0.0.1:6379/0
GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_TOKEN=
AGENT_SECRET=
INSTANCE_ID=slide-agent-1

# cosmic-slides-2 model config. The adapter maps these to MODEL_* env vars.
# Default backend is Fireworks Qwen. With an OPENAI_API_KEY (or SLIDE_AGENT_OPENAI_API_KEY)
# and no explicit model/Fireworks key, the agent upgrades to OpenAI gpt-5.6-terra @ xhigh.
SLIDE_AGENT_OPENAI_API_KEY=
MODEL_REASONING_EFFORT=xhigh
SLIDE_AGENT_FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
SLIDE_AGENT_FIREWORKS_API_KEY=
SLIDE_AGENT_FIREWORKS_MODEL=accounts/fireworks/models/glm-5p3-flash
VISION_MODEL_NAME=accounts/fireworks/models/glm-5p3-flash
MODEL_MAX_TOKENS=16384
HTML_MODEL_MAX_TOKENS=4096
MODEL_TIMEOUT_SEC=300
MODEL_HTTP_RETRIES=3

# Rendering/cataloging.
SLIDE_AGENT_LIBREOFFICE_PATH=soffice
SLIDE_AGENT_PDFTOPPM_PATH=pdftoppm
SLIDE_AGENT_MAX_SLIDES=50
SLIDE_AGENT_MAX_SLIDES_PER_DECK=50
SLIDE_AGENT_VALIDATE_OUTPUTS=true
SLIDE_AGENT_FORCE_CATALOG_DEFAULT=false
CATALOG_PARALLELISM=5
BUILDER_PARALLELISM=2
BUILDER_MAX_REPAIR_ROUNDS=2
HTML_MAX_REPAIR_ROUNDS=1
HTML_RENDER_TIMEOUT_MS=45000
HTML_VIEWPORT_WIDTH=1440
HTML_VIEWPORT_HEIGHT=900
HTML_DEVICE_SCALE=1.5
SLIDE_AGENT_DOCS_PARSER_AGENT_ID=cosmic/docs-parser-agent:1.0.0

# Leave empty to force orchestrator/user choice for deck creation.
SLIDE_AGENT_DEFAULT_WORKFLOW=

# Asset cache and stock-photo provider.
PEXELS_API_KEY=
ASSETS_CACHE_DIR=assets/cache

# Firecrawl research tools.
FIRECRAWL_API_KEY=
FIRECRAWL_API_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_REQUEST_TIMEOUT_SEC=120
FIRECRAWL_EXTRACT_POLL_INTERVAL_SEC=2
FIRECRAWL_EXTRACT_MAX_WAIT_SEC=120
FIRECRAWL_AGENT_POLL_INTERVAL_SEC=3
FIRECRAWL_AGENT_MAX_WAIT_SEC=240

# xAI image generation tools.
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-imagine-image-pro
XAI_TIMEOUT_SEC=180
IMAGE_AGENT_DEFAULT_SIZE=1536x1024
IMAGE_AGENT_DEFAULT_QUALITY=high
IMAGE_AGENT_MAX_IMAGES_PER_REQUEST=4
IMAGE_AGENT_MAX_PROMPT_CHARS=6000

# Local Python sandbox tool. Network and pip remain disabled by default.
ENABLE_PYTHON_SANDBOX_TOOL=true
PYTHON_SANDBOX_TIMEOUT_SEC=25
PYTHON_SANDBOX_MAX_FILES=8
PYTHON_SANDBOX_MAX_BYTES_PER_FILE=10000000
PYTHON_SANDBOX_MAX_SCRIPT_BYTES=256000
PYTHON_SANDBOX_ALLOW_NETWORK=false
PYTHON_SANDBOX_ALLOW_PIP=false
PYTHON_SANDBOX_PIP_TIMEOUT_SEC=120
PYTHON_SANDBOX_VENV_CACHE_ROOT=

# Slide Agent environment variables
# Copy to /etc/cosmic/agents/slide-agent.env and fill in values

REDIS_URL=redis://127.0.0.1:6379/0
GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_TOKEN=
AGENT_SECRET=
INSTANCE_ID=slide-agent-local-1

# Internal LLM (default: Fireworks Kimi K2.5)
SLIDE_AGENT_MIMO_API_KEY=
SLIDE_AGENT_MIMO_BASE_URL=https://api.fireworks.ai/inference/v1
SLIDE_AGENT_MIMO_MODEL=accounts/fireworks/models/kimi-k2p5
SLIDE_AGENT_MIMO_TIMEOUT_SEC=120.0
SLIDE_AGENT_MIMO_TEMPERATURE=0.6
SLIDE_AGENT_MIMO_REASONING_ENABLED=true
SLIDE_AGENT_MIMO_REASONING_MAX_TOKENS=256
SLIDE_AGENT_MIMO_APP_NAME=COSMIC Slide Agent
SLIDE_AGENT_MIMO_SITE_URL=
SLIDE_AGENT_ENABLE_INTERNAL_LLM=true

# LangGraph
SLIDE_AGENT_USE_LANGGRAPH=true
SLIDE_AGENT_MAX_TOOL_ROUNDS=10

# Templates
SLIDE_AGENT_DEFAULT_TEMPLATE=business-meeting

# Rendering
SLIDE_AGENT_LIBREOFFICE_PATH=soffice
SLIDE_AGENT_PDFTOPPM_PATH=pdftoppm
SLIDE_AGENT_RENDER_DPI=200
SLIDE_AGENT_EXPORT_PDF=true
SLIDE_AGENT_MAX_SLIDES=50
SLIDE_AGENT_MAX_VALIDATION_ATTEMPTS=4
SLIDE_AGENT_DOCS_PARSER_AGENT_ID=cosmic/docs-parser-agent:1.0.0

# Copy to /etc/cosmic/agents/alpha-agent.env and fill in values.
# Bootstrap renders REDIS_URL, GATEWAY_URL, GATEWAY_INTERNAL_TOKEN, AGENT_SECRET,
# and INSTANCE_ID automatically.

REDIS_URL=redis://127.0.0.1:6379/0
GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_TOKEN=
ORCHESTRATOR_URL=http://127.0.0.1:8743
ORCHESTRATOR_INTERNAL_TOKEN=
AGENT_SECRET=
INSTANCE_ID=alpha-agent-1

# Alpha is installed by bootstrap but not enabled unless this is true.
ALPHA_AGENT_ENABLED=false

# VM-local Alpha runtime roots.
ALPHA_WORKSPACE_ROOT=/var/lib/cosmic/alpha
ALPHA_CODEX_HOME=/var/lib/cosmic/alpha/homes/codex
ALPHA_CURSOR_HOME=/var/lib/cosmic/alpha/homes/cursor
ALPHA_PROJECT_DB_PATH=

# Codex execution harness. Authentication is managed from desktop Settings > Agents > Codex.
ALPHA_CODEX_MODEL=
# Current VM kernels can reject Codex's workspace-write sandbox with bwrap loopback errors.
# Keep Alpha restricted by its workspace/project policy until the Docker/LXD task container lands.
ALPHA_CODEX_SANDBOX=danger-full-access
ALPHA_CODEX_TIMEOUT_SEC=3600

# Cursor execution harness. Authentication is OAuth-only from desktop Settings > Agents > Cursor.
ALPHA_CURSOR_MODEL=composer
ALPHA_CURSOR_TIMEOUT_SEC=3600

# Docker workspace runner. Docker remains available for workspace/container smoke checks.
ALPHA_DOCKER_IMAGE=ubuntu:24.04
ALPHA_DOCKER_NETWORK=bridge
ALPHA_DOCKER_MEMORY=4g
ALPHA_DOCKER_CPUS=2
ALPHA_DOCKER_PIDS_LIMIT=512
ALPHA_DOCKER_TIMEOUT_SEC=300
ALPHA_ALLOW_DOCKER_SMOKE=false

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bundle_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "doc_id": {
      "type": "string",
      "maxLength": 80
    },
    "asset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "max_chars": {
      "type": "integer",
      "minimum": 500,
      "maximum": 12000
    }
  },
  "required": ["bundle_id", "asset_id"],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bundle_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Parsed bundle ID that owns the canonical document.md surface."
    },
    "doc_id": {
      "type": "string",
      "maxLength": 80,
      "description": "Optional parsed document ID. Required when the bundle contains multiple documents."
    },
    "read_kind": {
      "type": "string",
      "enum": ["document", "section", "page_range", "slide_range", "chunk_ids", "markdown_window"],
      "description": "How to read parsed content. Use document for the canonical full-document markdown surface; use markdown_window for anchor-based local windows."
    },
    "section_id": {
      "type": "string",
      "maxLength": 120
    },
    "chunk_ids": {
      "type": "array",
      "items": { "type": "string", "maxLength": 120 },
      "maxItems": 8
    },
    "start_page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "end_page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "start_slide": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "end_slide": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "anchor_id": {
      "type": "string",
      "maxLength": 120
    },
    "offset_chars": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000000,
      "description": "Start offset into canonical document.md when reading the full document sequentially."
    },
    "before_chars": {
      "type": "integer",
      "minimum": 0,
      "maximum": 12000
    },
    "after_chars": {
      "type": "integer",
      "minimum": 0,
      "maximum": 12000
    },
    "max_chars": {
      "type": "integer",
      "minimum": 500,
      "maximum": 12000,
      "description": "Maximum number of characters to return in this read window. For full-document reads, keep walking with next_offset_chars until complete."
    }
  },
  "required": ["bundle_id"],
  "additionalProperties": false
}

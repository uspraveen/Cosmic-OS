{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bundle_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "doc_id": {
      "type": "string",
      "maxLength": 80
    },
    "read_kind": {
      "type": "string",
      "enum": ["document", "section", "page_range", "slide_range", "chunk_ids", "markdown_window"]
    },
    "section_id": {
      "type": "string",
      "maxLength": 120
    },
    "chunk_ids": {
      "type": "array",
      "items": { "type": "string", "maxLength": 120 },
      "maxItems": 8
    },
    "start_page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "end_page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "start_slide": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "end_slide": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "anchor_id": {
      "type": "string",
      "maxLength": 120
    },
    "offset_chars": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2000000
    },
    "before_chars": {
      "type": "integer",
      "minimum": 0,
      "maximum": 12000
    },
    "after_chars": {
      "type": "integer",
      "minimum": 0,
      "maximum": 12000
    },
    "max_chars": {
      "type": "integer",
      "minimum": 500,
      "maximum": 12000
    }
  },
  "required": ["bundle_id"],
  "additionalProperties": false
}

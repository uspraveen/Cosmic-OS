{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bundle_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "index_kind": {
      "type": "string",
      "enum": ["documents", "sections", "chunks"]
    },
    "doc_id": {
      "type": "string",
      "maxLength": 80
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": ["bundle_id"],
  "additionalProperties": false
}

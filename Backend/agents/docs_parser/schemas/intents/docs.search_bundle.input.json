{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bundle_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "search_kind": {
      "type": "string",
      "enum": ["sections", "chunks"]
    },
    "doc_ids": {
      "type": "array",
      "items": { "type": "string", "maxLength": 80 },
      "maxItems": 12
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    }
  },
  "required": ["bundle_id", "query"],
  "additionalProperties": false
}

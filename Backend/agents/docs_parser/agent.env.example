REDIS_URL=redis://127.0.0.1:6379/0
GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_TOKEN=<internal-service-token>
AGENT_SECRET=<agent-shared-secret>
INSTANCE_ID=docs-parser-agent-1
DOCS_PARSER_ENABLE_OCR=true
DOCS_PARSER_GENERATE_PAGE_IMAGES=false
DOCS_PARSER_GENERATE_PICTURE_IMAGES=true
DOCS_PARSER_ENABLE_PICTURE_DESCRIPTION=true
OPENAI_API_KEY=
DOCS_PARSER_PICTURE_DESCRIPTION_API_URL=https://api.openai.com/v1/chat/completions
DOCS_PARSER_PICTURE_DESCRIPTION_MODEL=gpt-4.1-mini
DOCS_PARSER_PICTURE_DESCRIPTION_PRESET=qwen
DOCS_PARSER_PICTURE_DESCRIPTION_TIMEOUT_SEC=90
DOCS_PARSER_PICTURE_DESCRIPTION_CONCURRENCY=4
DOCS_PARSER_PICTURE_DESCRIPTION_BATCH_SIZE=4
DOCS_PARSER_PICTURE_DESCRIPTION_MAX_NEW_TOKENS=220
DOCS_PARSER_PICTURE_DESCRIPTION_SCALE=2.0
DOCS_PARSER_PICTURE_DESCRIPTION_AREA_THRESHOLD=0.05
DOCS_PARSER_PICTURE_DESCRIPTION_MIN_CONFIDENCE=0.2
DOCS_PARSER_PICTURE_DESCRIPTION_DENY_LABELS=logo,icon,signature,stamp,qr_code,bar_code
DOCS_PARSER_MAX_INPUT_ARTIFACTS=8
DOCS_PARSER_MAX_INPUT_FILE_BYTES=20971520
DOCS_PARSER_MAX_NUM_PAGES=200
DOCS_PARSER_MAX_CHUNK_CHARS=2400
DOCS_PARSER_CHUNK_OVERLAP_CHARS=280

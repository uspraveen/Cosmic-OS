# Copy to agent.env and set secrets locally. Do not commit agent.env.
REDIS_URL=redis://127.0.0.1:6379/0
GATEWAY_URL=http://127.0.0.1:8080
GATEWAY_INTERNAL_TOKEN=
AGENT_SECRET=
INSTANCE_ID=email-agent-local-1

# Cosmic Mail API
COSMIC_MAIL_BASE_URL=
COSMIC_MAIL_API_TOKEN=
COSMIC_MAIL_TIMEOUT_SEC=20
COSMIC_MAIL_PRIMARY_MAILBOX_ADDRESS=

# OpenAI-compatible internal email LLM
EMAIL_AGENT_INTERNAL_LLM_API_KEY=
# Root only, ending in /v1 — do NOT add /chat/completions.
EMAIL_AGENT_INTERNAL_LLM_BASE_URL=
# Current official OpenAI mini model id.
EMAIL_AGENT_INTERNAL_LLM_MODEL=gpt-5-mini
EMAIL_AGENT_INTERNAL_LLM_TIMEOUT_SEC=120
EMAIL_AGENT_ENABLE_INTERNAL_LLM=true

EMAIL_AGENT_MAX_SEARCH_RESULTS=12
EMAIL_AGENT_MAX_THREAD_MESSAGES=50
EMAIL_AGENT_MAX_ATTACHMENT_DOWNLOADS=8
EMAIL_AGENT_MAX_ATTACHMENT_BYTES=15728640
EMAIL_AGENT_ATTACHMENT_DOCS_AUTO_PARSE_ENABLED=true
EMAIL_AGENT_DOCS_PARSER_AGENT_ID=cosmic/docs-parser-agent:1.0.0
EMAIL_AGENT_ATTACHMENT_DOCS_PARSE_TIMEOUT_SEC=240
EMAIL_AGENT_ATTACHMENT_DOCS_PARSE_RECONCILE_TIMEOUT_SEC=900
EMAIL_AGENT_ATTACHMENT_DOCS_PARSE_POLL_INTERVAL_SEC=0.25

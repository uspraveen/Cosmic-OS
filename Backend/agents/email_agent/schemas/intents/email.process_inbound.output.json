{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "response": { "type": "string" },
    "summary": { "type": "string" },
    "thread_id": { "type": "string" },
    "message_id": { "type": "string" },
    "mailbox_address": { "type": "string" },
    "from_address": { "type": "string" },
    "trusted_sender": { "type": "boolean" },
    "sender_role": { "type": "string" },
    "subject": { "type": "string" },
    "matched_instruction": { "type": ["object", "null"] },
    "matched_instructions": { "type": "array", "items": { "type": "object" } },
    "instruction_match_reason": { "type": ["string", "null"] },
    "auto_reply": { "type": ["object", "null"] },
    "attachments": { "type": "array", "items": { "type": "object" } },
    "sent": { "type": ["boolean", "null"] },
    "delivery_status": { "type": ["string", "null"] }
  },
  "required": ["response", "summary", "thread_id", "message_id", "attachments"]
}
